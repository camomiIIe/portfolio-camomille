---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const {
  title = 'Camila Santos — Senior Product Designer',
  description = 'Visual + motion design that makes products feel alive. Senior Product Designer focused on UX motion, design systems, and illustration.',
  isHome = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#E91E8C" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  />

  <title>{title}</title>
</head>
<body>
  <Header isHome={isHome} />

  <main>
    <slot />
  </main>

  <Footer />

  <!-- Lottie player (CDN) -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.12.2/lottie.min.js"></script>

  <!-- Client behaviors -->
  <script>
    import '@/scripts/client.ts';
  </script>
</body>
</html>
