---
import type { WorkItem } from '@/utils/work';

export interface Props {
  project: WorkItem;
  number: string;
}

const { project, number } = Astro.props;
const { slug, title, discipline, year, cover, coverAlt, coverClass } = project;
---

<a href={`/work/${slug}`} class="project reveal">
  <div class="project-cover">
    <span class="project-num">{number}</span>
    {cover ? (
      <img class="cover-art" src={cover} alt={coverAlt ?? title} />
    ) : (
      <div class={`cover-art ${coverClass ?? 'cover-placeholder'}`}>
        {!coverClass && (
          <div class="ph-text">
            <strong>Slot for case</strong>
            cover image goes here
          </div>
        )}
      </div>
    )}
  </div>
  <div class="project-meta">
    <h3 class="project-title">{title}</h3>
    <span class="project-tag">{discipline} · {year}</span>
  </div>
</a>
