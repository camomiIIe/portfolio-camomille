---
export interface LinkItem {
  label: string;
  url: string;
}

export interface Props {
  links: LinkItem[];
}

const { links = [] } = Astro.props;
---

<div class="case-links">
  {links.map((link) => (
    <a class="case-link" href={link.url} target="_blank" rel="noopener noreferrer">
      {link.label}
    </a>
  ))}
</div>

<style>
.case-links {
  display: grid;
  gap: 16px;
  margin: 40px 0 16px;
}

.case-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16px 22px;
  border-radius: 18px;
  background: var(--navy);
  color: white;
  text-decoration: none;
  font-weight: 700;
  transition: transform 200ms ease, background 200ms ease;
}

.case-link:hover {
  transform: translateY(-1px);
  background: #382f69;
}
</style>
