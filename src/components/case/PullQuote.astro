---
export interface Props {
  align?: 'left' | 'center' | 'right';
}

const { align = 'center' } = Astro.props;
---

<blockquote class={`pull-quote pull-quote--${align}`}>
  <p><slot /></p>
</blockquote>

<style>
.pull-quote {
  margin: 0 auto 48px;
  max-width: 820px;
  padding: 28px 32px;
  border-left: 4px solid var(--pink);
  background: rgba(233, 30, 140, 0.05);
  color: var(--navy);
  font-size: clamp(1.1rem, 1.5vw, 1.35rem);
  line-height: 1.75;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.pull-quote p {
  margin: 0;
}

.pull-quote--left { text-align: left; }
.pull-quote--center { text-align: center; }
.pull-quote--right { text-align: right; }

@media (max-width: 720px) {
  .pull-quote {
    padding: 22px 24px;
    margin-bottom: 36px;
  }
}
</style>
