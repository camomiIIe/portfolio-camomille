---
import type { WorkItem } from '@/utils/work';
import ProjectCard from './ProjectCard.astro';

export interface Props {
  work: WorkItem[];
}

const { work } = Astro.props;

const allWork = [...work].sort((a, b) => a.order - b.order);
---

<section class="work" id="work">
  <div class="work-header">
    <h2 class="work-title">Selected <em>Work</em></h2>
    <a href="#projects" class="scroll-pill" aria-label="Scroll to projects">
      <span class="arrow">↓</span>
      <span>Let's start?</span>
    </a>
  </div>

  <div class="project-grid-3" id="projects">
    {allWork.map((project, i) => (
      <ProjectCard project={project} number={String(i + 1).padStart(2, '0')} />
    ))}
    <div class="project project--soon reveal">
      <div class="project-cover cover-placeholder">
        <div class="ph-text">
          <strong>More case studies</strong>
          coming soon
        </div>
      </div>
      <div class="project-meta">
        <span class="project-title">Work in progress</span>
        <span class="project-tag">2026</span>
      </div>
    </div>
  </div>
</section>
