---
import type { WorkItem } from '@/utils/work';
import FeaturedProject from './FeaturedProject.astro';
import ProjectCard from './ProjectCard.astro';

export interface Props {
  work: WorkItem[];
}

const { work } = Astro.props;

const allWork = [...work].sort((a, b) => a.order - b.order);
const featured = allWork.find((w) => w.featured) ?? allWork[0];
const others = allWork.filter((w) => w.slug !== featured?.slug);
---

<section class="work" id="work">
  <div class="work-header">
    <h2 class="work-title">Selected <em>Work</em></h2>
    <a href="#projects" class="scroll-pill" aria-label="Scroll to projects">
      <span class="arrow">↓</span>
      <span>Let's start?</span>
    </a>
  </div>

  {featured && <FeaturedProject project={featured} />}

  <div class="project-grid-3">
    {others.map((project, i) => (
      <ProjectCard project={project} number={String(i + 2).padStart(2, '0')} />
    ))}
  </div>
</section>
