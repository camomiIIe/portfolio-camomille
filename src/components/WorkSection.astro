---
import { getCollection } from 'astro:content';
import FeaturedProject from './FeaturedProject.astro';
import ProjectCard from './ProjectCard.astro';

// Pull cases from the content collection, filter drafts, sort by `order`.
const allWork = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const featured = allWork.find((w) => w.data.featured) ?? allWork[0];
const others = allWork.filter((w) => w.id !== featured?.id);
---

<section class="work" id="work">
  <div class="work-header">
    <h2 class="work-title">Selected <em>Work</em></h2>
    <a href="#projects" class="scroll-pill" aria-label="Scroll to projects">
      <span class="arrow">↓</span>
      <span>Let's start?</span>
    </a>
  </div>

  {featured && <FeaturedProject project={featured} />}

  <div class="project-grid-3">
    {others.map((project, i) => (
      <ProjectCard project={project} number={String(i + 2).padStart(2, '0')} />
    ))}
  </div>
</section>
