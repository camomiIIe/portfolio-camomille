---
// Pink hero — wordmark (left) + headline with navy highlights (right).
// The id="hero-pink" is read by client.ts to drive the header pink/white toggle.
---

<section class="hero-pink" id="hero-pink">
  <div class="hero-grid">
    <div class="hero-left">
      <img class="wordmark-art" src="/assets/assinatura-final.svg" alt="camomille artwork" />
    </div>
    <div class="hero-right">
      <h1 class="hero-display">
        I design how products<br />
        <span class="hl">move</span>, <span class="hl">feel</span>, and <span class="hl">respond</span>.
      </h1>
    </div>
  </div>
</section>
