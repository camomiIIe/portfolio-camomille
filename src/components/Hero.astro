---
// Pink hero — wordmark (left) + headline with navy highlights (right).
// The id="hero-pink" is read by client.ts to drive the header pink/white toggle.
---

<section class="hero-pink" id="hero-pink">
  <div class="hero-grid">
    <div class="hero-left">
      <div class="wordmark-art" data-lottie-src="/assets/Assinatura V2.json" data-lottie-loop="true" data-lottie-autoplay="true" role="img" aria-label="camomille artwork"></div>
    </div>
    <div class="hero-right">
      <h1 class="hero-display">
        I design how products and brands
        <span class="hl">work</span>, <span class="hl">look</span>, and <span class="hl">move</span>.
      </h1>
    </div>
  </div>
</section>
