---
import type { WorkItem } from '@/utils/work';

export interface Props {
  project: WorkItem;
}

const { project } = Astro.props;
const {
  slug,
  title,
  discipline,
  year,
  summary,
  cover,
  coverAlt,
  coverClass
} = project;
---

<article class="featured-project reveal" id="projects">
  <a href={`/work/${slug}`} class="featured-cover">
    <span class="featured-badge">01 · Featured</span>
    {cover ? (
      <img class="cover-art" src={cover} alt={coverAlt ?? title} />
    ) : (
      <div class={`cover-art ${coverClass ?? 'cover-placeholder'}`}></div>
    )}
  </a>
  <div class="featured-info">
    <div class="featured-meta">{discipline} · {year}</div>
    <h3 class="featured-title">{title}</h3>
    <p class="featured-desc">{summary}</p>
    <a href={`/work/${slug}`} class="featured-link">View case <span>→</span></a>
  </div>
</article>
