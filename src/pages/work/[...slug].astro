---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { WorkItem } from '@/utils/work';
import { workItems } from '@/utils/work';

export async function getStaticPaths() {
  return workItems.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

interface Props {
  entry: WorkItem;
}

const { entry } = Astro.props;
const { Content, role, company, year, title, summary, cover, coverAlt, coverClass, hideCover } = entry;

const metaParts = [role, company, year].filter(Boolean);
---

<BaseLayout title={`${title} — Camila Santos`} description={summary}>
  <article class="case-page">
    <a href="/" class="case-back">← Back home</a>

    <div class="case-meta">
      {metaParts.map((part, i) => (
        <>
          <span>{part}</span>
          {i < metaParts.length - 1 && <span style="color:var(--muted)">·</span>}
        </>
      ))}
    </div>

    <h1 class="case-title">{title}</h1>
    <p class="case-summary">{summary}</p>

    {!hideCover && (
      <div class={`case-cover ${coverClass ?? ''}`}>
        {cover && <img src={cover} alt={coverAlt ?? title} />}
      </div>
    )}

    <div class="case-body">
      <Content />
    </div>
  </article>
</BaseLayout>
